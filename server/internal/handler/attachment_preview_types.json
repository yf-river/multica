{
  "$comment": "Single source of truth for text attachment previews. Extensions omit the leading dot and are matched case-insensitively. Update this file, then run pnpm generate:attachment-preview-types.",
  "text_extensions": [
    "md", "markdown", "txt", "log", "csv", "tsv",
    "html", "htm", "json", "xml", "yml", "yaml", "toml", "ini", "conf",
    "sh", "bash", "zsh", "py", "rb", "go", "rs",
    "ts", "tsx", "js", "jsx", "mjs", "cjs",
    "css", "scss", "sass", "less", "sql",
    "java", "kt", "swift", "c", "cc", "cpp", "h", "hpp",
    "cs", "php", "lua", "vim", "dockerfile", "makefile"
  ],
  "text_content_types": [
    "application/json",
    "application/javascript",
    "application/xml",
    "application/x-yaml",
    "application/yaml",
    "application/toml",
    "application/x-sh",
    "application/x-httpd-php"
  ],
  "text_basenames": ["dockerfile", "makefile", ".env", ".gitignore"]
}
