{
  "name": "@multica-ai/dsh-runtime",
  "version": "0.3.4",
  "private": true,
  "description": "DeepSeek Harness runtime bridge for Multica",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yf-river/multica.git",
    "directory": "packages/dsh-runtime"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "compat.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack:runtime": "node scripts/pack.mjs",
    "bundle:daemon": "pnpm build && node scripts/pack.mjs ../../server/internal/daemon/dshbundle/bundle"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-cmdline": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-user-approval": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-tool-ask-user": ">=0.2.1-rc.3 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-cmdline": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-ask-user": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.3",
    "@deepseek-ai/dsh-cmdline": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.3",
    "@deepseek-ai/dsh-mcp-resources": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.3",
    "@types/node": "catalog:",
    "commander": "^15.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.3",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.3",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3",
