{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "artifacts/**",
    "server/bin/**",
    "**/dist/**",
    "**/.next/**",
    "**/out/**",
    "**/coverage/**",
    "**/node_modules/**",
    "packages/views/locales/**"
  ],
  "ignoreFiles": [
    "apps/desktop/src/renderer/src/env.d.ts",
    "apps/desktop/src/preload/index.d.ts",
    "apps/web/lib/use-cases-source.ts",
    "apps/web/source.config.ts",
    "apps/web/test/helpers.tsx"
  ],
  "ignoreBinaries": [
    "codex",
    "eslint",
    "go",
    "ps",
    "python3",
    "readlink",
    "rg"
  ],
  "ignoreDependencies": [
    "@base-ui/react",
    "@dnd-kit/core",
    "@dnd-kit/sortable",
    "@dnd-kit/utilities",
    "@emoji-mart/data",
    "@floating-ui/dom",
    "@multica/tsconfig",
    "@tiptap/extension-code-block-lowlight",
    "@tiptap/extension-image",
    "@tiptap/extension-link",
    "@tiptap/extension-mention",
    "@tiptap/extension-placeholder",
    "@tiptap/extension-table",
    "@tiptap/extension-table-cell",
    "@tiptap/extension-table-header",
    "@tiptap/extension-table-row",
    "@tiptap/extension-typography",
    "@tiptap/markdown",
    "@tiptap/pm",
    "@tiptap/react",
    "@tiptap/starter-kit",
    "@tiptap/suggestion",
    "@types/*",
    "@vitejs/plugin-react",
    "class-variance-authority",
    "clsx",
    "cmdk",
    "date-fns",
    "embla-carousel-react",
    "emoji-mart",
    "linkify-it",
    "lowlight",
    "next-themes",
    "react-day-picker",
    "react-markdown",
    "react-resizable-panels",
    "recharts",
    "rehype-raw",
    "remark-gfm",
    "shadcn",
    "shiki",
    "sonner",
    "tailwind-merge",
    "tailwindcss",
    "tw-animate-css",
    "vaul",
    "vitest",
    "zod"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        "playwright.config.ts",
        "scripts/**/*.{js,mjs,cjs,ts}",
        "e2e/**/*.{ts,tsx}"
      ],
      "project": [
        "*.{js,mjs,cjs,ts}",
        "scripts/**/*.{js,mjs,cjs,ts}",
        "e2e/**/*.{ts,tsx}"
      ]
    },
    "apps/web": {
      "entry": [
        "app/**/page.{ts,tsx}",
        "app/**/layout.{ts,tsx}",
        "app/**/route.{ts,tsx}",
        "app/global-error.tsx",
        "app/not-found.tsx",
        "next.config.ts",
        "eslint.config.mjs"
      ],
      "project": [
        "**/*.{ts,tsx,mjs}"
      ]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/src/main.tsx",
        "electron.vite.config.ts",
        "eslint.config.mjs",
        "scripts/**/*.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.mjs",
        "*.{ts,mjs}"
      ]
    },
    "apps/docs": {
      "entry": [
        "app/**/*.{ts,tsx,mdx}",
        "components/**/*.{ts,tsx}",
        "source.config.ts",
        "next.config.ts"
      ],
      "project": [
        "**/*.{ts,tsx,mdx}"
      ]
    },
    "packages/core": {
      "entry": [
        "index.ts",
        "**/index.ts",
        "**/*.test.{ts,tsx}",
        "eslint.config.mjs"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ]
    },
    "packages/views": {
      "entry": [
        "index.ts",
        "**/index.ts",
        "**/*.test.{ts,tsx}",
        "eslint.config.mjs"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ]
    },
    "packages/ui": {
      "entry": [
        "index.ts",
        "components/**/*.{ts,tsx}",
        "markdown/index.ts",
        "styles/**/*.{ts,tsx,css}",
        "eslint.config.mjs"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ]
    },
    "packages/eslint-config": {
      "entry": [
        "*.js"
      ],
      "project": [
        "*.js"
      ]
    }
  }
}
