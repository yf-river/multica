# 数据库
POSTGRES_DB=multica
POSTGRES_USER=multica
POSTGRES_PASSWORD=multica
POSTGRES_PORT=5432
DATABASE_URL=postgres://multica:multica@localhost:5432/multica?sslmode=disable
# 可选的 pgxpool 调优。默认每 pod 25 / 5，通常够用。
# 也可以在 DATABASE_URL 上设 pool_max_conns / pool_min_conns query 参数；
# 下面的 env 变量优先于 URL 参数。
# DATABASE_MAX_CONNS=25
# DATABASE_MIN_CONNS=5

# Server
# APP_ENV 控制生产安全检查。Docker 自部署默认把 APP_ENV 钉为 "production"。
# 本地开发可不设。
APP_ENV=
PORT=8080
# Docker Compose 消费扁平端口值。直接设 BACKEND_PORT 覆盖后端 host 端口。
BACKEND_PORT=8080
# compose 之外的本地/自部署后端端口 helper 的可选别名。
# API_PORT=8080
# SERVER_PORT=8080
FRONTEND_PORT=3000
# 由 docker-compose.selfhost.yml / 本地脚本从 FRONTEND_PORT 派生。
# 仅当前端在不同 origin/域名 上服务时显式设置。
FRONTEND_ORIGIN=http://localhost:${FRONTEND_PORT}
# Prometheus metrics 默认禁用。启用时绑回环地址，除非用私有网络、allowlist
# 或代理认证保护 listener。不要通过公开 app/API ingress 暴露该端点。
# HTTP 请求 metrics 仅在该 listener 启用后才开始累计。
# METRICS_ADDR=127.0.0.1:9090
JWT_SECRET=change-me-in-production
# 由 Makefile / 本地脚本从后端端口派生。
# 仅当守护进程通过不同 URL 访问 API 时显式设置。
# MULTICA_SERVER_URL=ws://localhost:8080/ws
# 由 docker-compose.selfhost.yml / 本地脚本从 FRONTEND_ORIGIN 派生。
# 仅当应用公开 URL 与本地前端不同时显式设置。
MULTICA_APP_URL=${FRONTEND_ORIGIN}
# API 从公网可达的 URL（无尾斜杠）。用于为 autopilot webhook 触发器铸造绝对
# webhook URL，并在 web UI 中显示正确的守护进程配置命令。在 same-origin
# 反向代理之后或纯 localhost 开发下留空——前端那种情况下会用
# window.origin + webhook_path 组合 URL。刻意不用 header 派生该值，避免
# 自部署反向代理未加固时的 Host / X-Forwarded-Host 欺骗。
MULTICA_PUBLIC_URL=
# 逗号分隔的 CIDR 列表，per-IP webhook 限流器允许信任其 X-Forwarded-For /
# X-Real-IP header 的反向代理。空（默认）= 不信任任何 header——限流器只用
# r.RemoteAddr，后端直接暴露时的安全形态。在后端前置 nginx/Caddy/Cloudflare
# 时设置：如 same-host 反向代理用 "127.0.0.1/32"，云部署用 CDN 公告的网段。
MULTICA_TRUSTED_PROXIES=
MULTICA_DAEMON_CONFIG=
MULTICA_WORKSPACE_ID=
MULTICA_DAEMON_ID=
MULTICA_DAEMON_DEVICE_NAME=
MULTICA_DAEMON_POLL_INTERVAL=3s
MULTICA_DAEMON_HEARTBEAT_INTERVAL=15s
MULTICA_CODEX_PATH=codex
MULTICA_CODEX_MODEL=
MULTICA_CODEX_WORKDIR=
MULTICA_CODEX_TIMEOUT=20m
# 训练与评估 Agent 默认使用 minimax-m2.7-ioa；当团队 MiniMax 额度不足时，
# 可临时切到 CodeBuddy 支持的模型，例如 hy3-preview-ioa。
MULTICA_PROMPT_EVALUATION_AGENT_MODEL=minimax-m2.7-ioa

# 自部署镜像通道
# 默认稳定 release 通道。pin 到精确 release 如 v0.2.4 可留在特定版本。
# 若所选 tag 尚未发布到 GHCR，用 make selfhost-build / build override。
MULTICA_IMAGE_TAG=latest
MULTICA_BACKEND_IMAGE=ghcr.io/multica-ai/multica-backend
MULTICA_WEB_IMAGE=ghcr.io/multica-ai/multica-web

# S3 / CloudFront
# S3_BUCKET — 仅 bucket 名（如 "my-bucket"）。不要包含
# ".s3.<region>.amazonaws.com" 后缀；server 从 S3_BUCKET + S3_REGION 构造公开 URL。
# S3_REGION 必须与 bucket 真实 region 一致。
S3_BUCKET=
S3_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL — 可选的 S3 兼容 endpoint（MinIO、RustFS、R2 等）。
# 对内部 Docker/VPC 主机如 http://rustfs:9000，保持 ATTACHMENT_DOWNLOAD_MODE=auto
# 或显式设 proxy，让浏览器/CLI 无需直接访问对象存储。
AWS_ENDPOINT_URL=
ATTACHMENT_DOWNLOAD_MODE=auto
ATTACHMENT_DOWNLOAD_URL_TTL=30m
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_SECRET=multica/cloudfront-signing-key
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_DOMAIN=
# COOKIE_DOMAIN — session + CloudFront cookie 的可选 Domain 属性。
# 单 host 部署（localhost、LAN IP 或单个主机名）留空——session cookie 变为
# host-only，正是浏览器想要的。仅在前端与后端位于同一注册域的不同子域时
# 设置（如 ".example.com"）。不要设为 IP 地址：RFC 6265 禁止 cookie
# Domain 属性用 IP 字面值，浏览器会默默丢弃这类 cookie。
COOKIE_DOMAIN=

# AUTH_TOKEN_TTL — 认证 token 生命周期。接受 Go duration 串（如
# "8760h"、"720h30m"）或纯整数秒。
# 默认：2592000（30 天）。可信网络上的自部署可设更长以减少重新认证频率。
# 注：TTL 越长，cookie 泄露后的暴露窗口越长。
# AUTH_TOKEN_TTL=2592000

# 本地文件存储（未设 S3_BUCKET 时的回退）
LOCAL_UPLOAD_DIR=./data/uploads
# 由 Makefile / 本地脚本从后端端口派生。
# 仅当 uploads 通过不同公开 URL 服务时显式设置。
# LOCAL_UPLOAD_BASE_URL=http://localhost:8080

# 安全
# 逗号分隔的 CORS 与 WebSocket 连接允许 origin 列表。
# 未设时默认为 localhost 开发 origin。
# 示例：CORS_ALLOWED_ORIGINS=https://app.multica.ai,https://staging.multica.ai
CORS_ALLOWED_ORIGINS=

# ==================== 限流（可选 Redis） ====================
# 公开 auth login 端点（/auth/login）的 per-IP 固定窗口限流器。由 Redis 支撑。
# 未设 REDIS_URL 限流器为 no-op（fail-open），后端启动时日志会打印
# "rate limiting disabled: REDIS_URL not configured"。同一 REDIS_URL 也被
# 实时 fan-out hub、PAT 缓存、守护进程 token 缓存复用。
# REDIS_URL=redis://localhost:6379/0
# 每 IP 每分钟最大登录请求数。默认：20。
# RATE_LIMIT_AUTH_LOGIN=20
# 逗号分隔的 CIDR，auth 限流器允许信任其 X-Forwarded-For 的来源。
# 空（默认）= 绝不信任 XFF，只用 RemoteAddr。
# 反向代理后必设——否则每个真实用户共享代理 IP，整个部署落进一个 bucket，
# /auth/login 变成一个共享 bucket。如 same-host Caddy/Nginx 用
# "127.0.0.1/32,::1/128"，ALB/CF 用 CDN 公告网段。
# 这与上面的 MULTICA_TRUSTED_PROXIES（管 autopilot webhook 限流器）是独立列表。
# RATE_LIMIT_TRUSTED_PROXIES=

# 实时 metrics 端点（/health/realtime）访问控制。见 MUL-1342。
# 未设时该端点仅服务无转发 header 的直连回环（127.0.0.1 / ::1）调用方，
# 其他一律 404——本地开发安全。反向代理（Caddy / Nginx 在 localhost:8080 前
# 终止 TLS）后的任何部署都必须设该 token，因为代理请求在 Go 层看起来像
# 回环；无 token 时这些请求被 404 拒绝。token 以
# `Authorization: Bearer <token>` 传递。
# REALTIME_METRICS_TOKEN=

# GitHub App 集成（设置 → GitHub "Connect GitHub"）
# 两者都设后 Connect 按钮才启用、webhook 才被接受；留空禁用集成。
# 见 docs/github-integration。
# GITHUB_APP_SLUG 是 https://github.com/apps/<slug> 的尾部。
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
# 可选：App-authenticated REST 调用用的 GitHub App 身份。设置后 setup 回调
# 在安装后立即用真实账号 login（org / user name）丰富 installation 行。
# 未设时该行以 "unknown" 占位符创建，下一次来自 GitHub 的 installation
# webhook 会覆盖它——两者都设可跳过那段过渡闪烁。
# GITHUB_APP_ID 是 App 设置页上显示的数字 "App ID"。
# GITHUB_APP_PRIVATE_KEY 是该页 "Private keys" 下生成的完整 PEM 块（含
# BEGIN/END 行）；保留换行。
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# 飞书 / Lark 机器人集成（设置 → 集成 "Bind to Lark"）
# 设置 MULTICA_LARK_SECRET_KEY 才启用——一个 base64 编码的 32 字节密钥，
# 静态加密每个 Bot 的 app secret。留空禁用。
# 生成：openssl rand -base64 32
MULTICA_LARK_SECRET_KEY=
# 国内飞书与国际 Lark 按安装（QR 扫码时）自动检测，并存存——正常使用留空。
# 它们是可选的部署级覆盖，强制每个安装走单一 host（代理、测试 mock、
# 单云 staging）；HTTP 驱动出站开放平台 API 调用，CALLBACK 驱动入站长连引导。
# 注：若你之前设为 https://open.larksuite.com 跑国际 Lark，升级后首次启动
# server 会把已有安装重标为 region=lark，之后可清空。见 docs/lark-bot-integration。
MULTICA_LARK_HTTP_BASE_URL=
MULTICA_LARK_CALLBACK_BASE_URL=

# 前端
# 留空——浏览器从页面 origin 自动派生，本地开发由 Makefile 设置。
# NEXT_PUBLIC_API_URL 显式设置时也喂给 Next.js SSR 代理。
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# 远端 API（可选）——设为把本地前端代理到远端后端
# 留空用本地后端（localhost:8080）
# REMOTE_API_URL=https://multica-api.copilothub.ai

# ==================== 自部署：控制注册（修复 #930） ====================
# 设为 "false" 完全禁用新用户注册（私有实例推荐）
ALLOW_SIGNUP=true
# Web UI 运行时从 /api/config 读 ALLOW_SIGNUP，所以切换只需重启后端 /
# compose stack——无需重建 web。不热加载。

# 可选：仅允许这些精确账号名（逗号分隔）
ALLOWED_ACCOUNTS=

# 设为 "true" 在本实例对所有调用方禁用工作区创建（#3433）。运维通常留空，
# 引导共享工作区后翻成 "true" 并重启，使后续用户从工作区设置添加、整个
# 部署对平台管理员可见。Web UI 运行时从 /api/config 读，所以切换需重启
# 后端但无需前端重建。
DISABLE_WORKSPACE_CREATION=

# ==================== 分析（PostHog） ====================
# 产品分析事件喂给 acquisition → activation → expansion 漏斗。
# 本地开发 / 自部署实例留空 POSTHOG_API_KEY；server 跑 no-op 分析客户端，
# 什么也不发。见 docs/analytics.md。
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# 可选覆盖 PostHog 事件属性的 `environment` 字段。
# 默认从 APP_ENV 派生并规范化为 production / staging / dev。
ANALYTICS_ENVIRONMENT=
# 即使设了 POSTHOG_API_KEY 也强制 no-op 客户端（CI / opt-out）。
ANALYTICS_DISABLED=
