{
  "groups": [
    {
      "name": "delivery-api",
      "paths": [
        "server/internal/handler/",
        "server/internal/cli/",
        "server/cmd/",
        "server/migrations/"
      ],
      "command": [
        "python3",
        "scripts/verify-delivery-coordination.py"
      ],
      "prebuild": true
    },
    {
      "name": "delivery-runtime",
      "paths": [
        "server/internal/daemon/",
        "server/internal/service/",
        "packages/views/chat/"
      ],
      "command": [
        "go",
        "-C",
        "server",
        "test",
        "./internal/daemon",
        "-run",
        "^TestReleasePause|^TestDeploymentDrain",
        "-count=1"
      ]
    },
    {
      "name": "delivery-worker",
      "paths": [
        "scripts/"
      ],
      "command": [
        "python3",
        "scripts/issue-delivery-worker.test.py"
      ],
      "prebuild": true
    },
    {
      "name": "delivery-publisher",
      "paths": [
        "scripts/"
      ],
      "command": [
        "python3",
        "scripts/release-environments.test.py"
      ],
      "prebuild": true
    },
    {
      "name": "delivery-coordination",
      "paths": [
        "scripts/"
      ],
      "command": [
        "python3",
        "scripts/delivery-coordination.test.py"
      ],
      "prebuild": true
    },
    {
      "name": "batch-closeout-api",
      "paths": [
        "server/internal/review/",
        "server/internal/handler/issue_review",
        "server/internal/supervision/",
        "packages/core/review/",
        "packages/views/modals/quick-create-issue",
        "packages/views/issues/components/review-"
      ],
      "command": [
        "python3",
        "scripts/verify-batch-closeout.py"
      ],
      "prebuild": true
    },
    {
      "name": "run-diff-capture",
      "paths": [
        "server/internal/codediff/",
        "server/internal/daemon/run_capture.go",
        "server/internal/handler/run_text_change.go"
      ],
      "command": [
        "go",
        "-C",
        "server",
        "test",
        "./internal/codediff",
        "-count=1"
      ],
      "prebuild": true
    },
    {
      "name": "run-text-migration",
      "paths": [
        "server/migrations/",
        "server/cmd/migrate/"
      ],
      "command": [
        "go",
        "-C",
        "server",
        "test",
        "./cmd/migrate",
        "./internal/migrations",
        "-count=1"
      ],
      "prebuild": true
    }
  ]
}
